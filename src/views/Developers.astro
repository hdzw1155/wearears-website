---
import Architecture from '../components/Architecture.astro';
import PageIntro from '../components/PageIntro.astro';
import FanDeck from '../components/FanDeck.astro';
import FallingTiles from '../components/FallingTiles.astro';
import { appSource, issuesUrl, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const steps = zh ? [
  ['核对协议边界与红线', '先查阅docs/HANDOFF.md与FILE_MAP.md，确认型号、固件门控与各品牌禁发指令，严禁向陌生设备盲发私有帧。'],
  ['实现WireDriver并注册', '在drivers/下实现协议解码与能力探测，通过confirmFeature()按回包声明能力，并在drivers/modules.json注册。'],
  ['离线回归与真机留痕', '运行py -X utf8 build.py verify跑通16套测试与234组双语校验；支持--drivers按需裁剪品牌驱动。'],
] : [
  ['Check guardrails & docs', 'Read docs/HANDOFF.md and FILE_MAP.md for firmware gating and blocked opcodes before adding frames.'],
  ['Implement WireDriver', 'Decode brand frames under drivers/, call confirmFeature() only after capability replies and register in drivers/modules.json.'],
  ['Verify offline & trim', 'Run py -X utf8 build.py verify (16 suites + 234 bilingual parity checks), or trim brand builds via --drivers.'],
];
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-label={zh ? '开发者概述' : 'Developers introduction'}>
    <div class="deck-card deck-card-hero">
      <FallingTiles primary="yellow" secondary="blue" />
      <PageIntro label="03 / DEVELOPERS" title={zh ? '为新的设备留下接口' : 'A place for the next device'}
        summary={zh ? 'WearEars将代码拆分为app、core与drivers三层，无需Gradle联网即可在Windows本地完成16套回归测试与驱动裁剪打包。'
          : 'WearEars splits into app, core and drivers, compiling and running 16 test suites offline without Gradle.'}>
        <div class="action-row">
          <a class="button button-primary" href={appSource + 'docs/HANDOFF.md'} target="_blank" rel="noopener noreferrer">{zh ? '阅读底层架构交接' : 'Read architecture handoff'} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span></a>
          <a class="button button-outline" href={appSource + 'docs/FILE_MAP.md'} target="_blank" rel="noopener noreferrer">{zh ? '文件导航指南' : 'Browse file map'} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span></a>
        </div>
      </PageIntro>
    </div>
  </section>

  <section class="slide-section deck-sheet ink-section" data-slide data-slide-index="1" aria-labelledby="system-title">
    <div class="deck-card deck-ink deck-fan-right">
      <FallingTiles primary="blue" secondary="red" />
      <div class="shell content-section architecture-grid">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>SYSTEM DESIGN</p>
          <h2 id="system-title">{zh ? '沿着四层架构看一次操作' : 'Follow a control through four layers'}</h2>
          <p>{zh ? '展开每一层查看职责和对应源码。' : 'Open a layer to read its role and inspect the source.'}</p>
        </div>
        <Architecture locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="contribute-title">
    <div class="deck-card deck-paper deck-fan-left">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell content-section split-content">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>CONTRIBUTE</p>
          <h2 id="contribute-title">{zh ? '贡献驱动与离线构建' : 'Contribute & build offline'}</h2>
          <a class="text-link" href={issuesUrl} target="_blank" rel="noopener noreferrer">{zh ? '参与项目讨论' : 'Join the project discussion'} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span></a>
        </div>
        <ol class="step-list">
          {steps.map(([title, body], index) => (
            <li><span class="entry-index">0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="3" aria-labelledby="sdk-title">
    <div class="deck-card deck-paper deck-fan-right">
      <FallingTiles primary="yellow" secondary="green" />
      <div class="shell content-section">
        <div class="roadmap-note">
          <p class="label"><span class="label-mark yellow"></span>{zh ? '规划中' : 'Planned'}</p>
          <div>
            <h2 id="sdk-title">{zh ? '扩展特性复测与独立文档' : 'Extended validation & docs roadmap'}</h2>
            <p>{zh ? 'app、core与drivers模块化拆分已完成。后续将逐品牌完成扩展特性的真机复测，并推进独立开发者文档站。'
              : 'The modular app/core/drivers split is live. Upcoming milestones focus on hardware validation of extended features and dedicated documentation.'}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</FanDeck>
