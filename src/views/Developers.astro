---
import Architecture from '../components/Architecture.astro';
import FallingTiles from '../components/FallingTiles.astro';
import FanDeck from '../components/FanDeck.astro';
import PageIntro from '../components/PageIntro.astro';
import { appSource, issuesUrl, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';

const steps = zh ? [
  ['核对协议边界与红线', '先查阅docs/HANDOFF.md与FILE_MAP.md，确认型号、固件门控与各品牌禁发指令，严禁向陌生设备盲发私有帧。'],
  ['实现WireDriver并注册', '在drivers/下实现协议解码与能力探测，通过confirmFeature()按回包声明能力，并在drivers/modules.json注册。'],
  ['离线回归与真机留痕', '运行py -X utf8 build.py verify跑通全部测试与双语校验；支持--drivers按需裁剪品牌驱动。'],
] : [
  ['Check guardrails & docs', 'Read docs/HANDOFF.md and FILE_MAP.md for firmware gating and blocked opcodes before adding frames.'],
  ['Implement WireDriver', 'Decode brand frames under drivers/, call confirmFeature() only after capability replies and register in drivers/modules.json.'],
  ['Verify offline & trim', 'Run py -X utf8 build.py verify for full regression and bilingual parity checks, or trim brand builds via --drivers.'],
];

const terminalSnippet = `# Android offline test suites + APK + signature verify
py -X utf8 build.py verify

# Trim APK to selected brand drivers
py -X utf8 build.py apk --drivers vivo,huawei,xiaomi,oppo

# Windows standalone tray EXE + 795 desktop checks
py -X utf8 desktop/build_desktop.py verify`;
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-label={zh ? '开发者概述' : 'Developers introduction'}>
    <div class="deck-card deck-card-hero">
      <FallingTiles primary="yellow" secondary="blue" />
      <PageIntro
        label="03 / DEVELOPERS"
        meta="APP · CORE · DRIVERS · OFFLINE BUILD"
        title={zh ? '为新的设备留下接口' : 'A place for the next device'}
        summary={zh
          ? 'WearEars将代码拆分为app、core与drivers三层，无需Gradle联网即可在Windows本地完成回归测试与驱动裁剪打包。'
          : 'WearEars splits into app, core and drivers, compiling and running offline regression suites without Gradle.'}
      >
        <div class="action-row">
          <a class="button button-primary" data-arrow="ext" href={appSource + 'docs/HANDOFF.md'} target="_blank" rel="noopener noreferrer">
            <span>{zh ? '阅读底层架构交接' : 'Read architecture handoff'}</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
          <a class="button button-outline" data-arrow="ext" href={appSource + 'docs/FILE_MAP.md'} target="_blank" rel="noopener noreferrer">
            <span>{zh ? '文件导航指南' : 'Browse file map'}</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>
      </PageIntro>
    </div>
  </section>

  <section class="slide-section deck-sheet ink-section" data-slide data-slide-index="1" aria-labelledby="system-title">
    <div class="deck-card deck-ink deck-fan-right ink-chamber">
      <FallingTiles primary="blue" secondary="red" />
      <div class="shell section-band-tight architecture-grid">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark"></span>SYSTEM DESIGN</p>
          <h2 id="system-title">{zh ? (<>四层架构，<br />看清一次操作</>) : 'Follow a control through four layers'}</h2>
          <p>{zh ? '展开每一层查看职责和对应源码。' : 'Open a layer to read its role and inspect the source.'}</p>
          <div class="chamber-metrics chamber-metrics-4">
            <div><strong>app</strong><span>{zh ? '安卓多端与磁贴' : 'Android & Tiles'}</span></div>
            <div><strong>desktop</strong><span>{zh ? 'Win托盘端' : 'Win Tray'}</span></div>
            <div><strong>core</strong><span>{zh ? '纯JVM规则' : 'Pure JVM'}</span></div>
            <div><strong>drivers</strong><span>{zh ? '9品牌裁剪' : '9 Drivers'}</span></div>
          </div>
        </div>
        <Architecture locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="contribute-title">
    <div class="deck-card deck-paper deck-fan-left">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell section-band-tight split-content">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark green"></span>CONTRIBUTE</p>
          <h2 id="contribute-title">{zh ? '贡献驱动与离线构建' : 'Contribute & build offline'}</h2>
          <a class="text-link" href={issuesUrl} target="_blank" rel="noopener noreferrer">
            {zh ? '参与项目讨论' : 'Join the project discussion'} <span aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>

        <div>
          <ol class="step-list">
            {steps.map(([title, body], index) => (
              <li>
                <span class="entry-index">0{index + 1}</span>
                <div>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </div>
              </li>
            ))}
          </ol>

          <div class="terminal-card" data-reveal style="--reveal-delay: 160ms">
            <div class="terminal-head">
              <span>WINDOWS OFFLINE CLI · BUILD.PY</span>
              <button
                type="button"
                class="terminal-copy"
                data-copy-code
                data-copied-label={zh ? '已复制' : 'COPIED'}
              >
                {zh ? '复制命令' : 'COPY'}
              </button>
            </div>
            <pre class="terminal-body"><code>{terminalSnippet}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="3" aria-labelledby="sdk-title">
    <div class="deck-card deck-sunk deck-fan-right">
      <FallingTiles primary="yellow" secondary="green" />
      <div class="shell section-band-tight">
        <div class="roadmap-note">
          <p class="label"><span class="label-mark yellow"></span>{zh ? '规划中' : 'PLANNED'}</p>
          <div>
            <h2 id="sdk-title">{zh ? '扩展特性复测与独立文档' : 'Extended validation & docs roadmap'}</h2>
            <p>
              {zh
                ? 'app、core与drivers模块化拆分已完成。后续将逐品牌推进扩展特性的真机复测，并建立独立开发者文档站。'
                : 'The modular app/core/drivers split is live. Upcoming milestones focus on hardware validation of extended features and dedicated documentation.'}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</FanDeck>
