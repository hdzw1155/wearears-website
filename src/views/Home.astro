---
import AnimatedAppIcon from '../components/AnimatedAppIcon.astro';
import AcousticSpecimen from '../components/AcousticSpecimen.astro';
import Architecture from '../components/Architecture.astro';
import FallingTiles from '../components/FallingTiles.astro';
import FanDeck from '../components/FanDeck.astro';
import ReleaseFeed from '../components/ReleaseFeed.astro';
import { compatibility } from '../data/compatibility';
import releases from '../data/releases.json';
import { pagePath, releasesUrl, site, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const currentRelease = releases[0];

const verifiedCount = compatibility.filter((r) => r.evidence === 'hardware').length;
const totalCount = compatibility.length;
const verifiedPct = Math.round((verifiedCount / totalCount) * 100);

const heroLetters = ['W', 'e', 'a', 'r', 'E', 'a', 'r', 's'];

const matrixItems = zh ? [
  {
    title: '分体电量读取',
    state: '已实现',
    dot: 'green',
    accent: 'var(--green)',
    tokens: ['左耳', '右耳', '充电盒', '整机兜底'],
  },
  {
    title: '降噪与进阶控制',
    state: '按型号',
    dot: 'blue',
    accent: 'var(--blue)',
    tokens: ['降噪/通透/关闭', '细分档位', '抗风噪', 'EQ与寻机'],
  },
  {
    title: '本机单端空间音频',
    state: '已实现',
    dot: 'green',
    accent: 'var(--yellow)',
    tokens: ['任意蓝牙耳机', '48kHz HRTF', '四种声场', '硬件避让'],
  },
  {
    title: '四端形态与四套皮肤',
    state: '已实现',
    dot: 'green',
    accent: 'var(--blue)',
    tokens: ['Wear OS 3+', 'Android 11+', 'Windows托盘', '眼镜纯黑HUD'],
  },
  {
    title: '局域网协同与短连接',
    state: '已实现',
    dot: 'green',
    accent: 'var(--red)',
    tokens: ['Local Mesh零云端', '4位PIN与内网防火墙', '手机快撤防抢占'],
  },
  {
    title: '听觉安全与零联网',
    state: '已实现',
    dot: 'green',
    accent: 'var(--green)',
    tokens: ['70%音量护栏', '入耳拦截响铃', '纯本地蓝牙', '零埋点'],
  },
] : [
  {
    title: 'Split Battery Telemetry',
    state: 'Implemented',
    dot: 'green',
    accent: 'var(--green)',
    tokens: ['Left', 'Right', 'Case', 'Standard fallback'],
  },
  {
    title: 'ANC & Extended Controls',
    state: 'By model',
    dot: 'blue',
    accent: 'var(--blue)',
    tokens: ['ANC / Aware / Off', 'Fine levels', 'Wind noise', 'EQ & Find'],
  },
  {
    title: 'Local Spatial Audio',
    state: 'Implemented',
    dot: 'green',
    accent: 'var(--yellow)',
    tokens: ['Any headset', '48 kHz HRTF', '4 soundstages', 'Auto bypass'],
  },
  {
    title: 'Four Screens & 4 Themes',
    state: 'Implemented',
    dot: 'green',
    accent: 'var(--blue)',
    tokens: ['Wear OS 3+', 'Android 11+', 'Windows Tray', 'AR Waveguide HUD'],
  },
  {
    title: 'LAN Mesh & Burst Mode',
    state: 'Implemented',
    dot: 'green',
    accent: 'var(--red)',
    tokens: ['Zero-cloud Mesh', '4-digit PIN & Firewall', 'Phone quick-park'],
  },
  {
    title: 'Hearing Safety & Offline',
    state: 'Implemented',
    dot: 'green',
    accent: 'var(--green)',
    tokens: ['70% volume guard', 'In-ear ring block', 'Local BT only', 'Zero telemetry'],
  },
];
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-labelledby="hero-title">
    <div class="deck-card deck-card-hero hero-section">
      <FallingTiles primary="yellow" secondary="blue" />
      <div class="shell hero-shell">
        <div class="hero-index label">
          <span><i class="label-mark" aria-hidden="true"></i> INDEPENDENT WEARABLE AUDIO</span>
          <span class="hero-index-right">
            <span>LOCAL BT · ZERO CLOUD</span>
            <span>WATCH <span class="hero-cross">×</span> PHONE <span class="hero-cross">×</span> WIN <span class="hero-cross">×</span> HUD</span>
          </span>
        </div>

        <div class="hero-stage">
          <div class="hero-copy">
            <h1 id="hero-title">
              <span class="hero-name" aria-label="WearEars">
                {heroLetters.map((char, idx) => (
                  <span
                    aria-hidden="true"
                    class={`hero-letter${idx === heroLetters.length - 1 ? ' hero-letter-s' : ''}`}
                    data-letter-idx={idx}
                  >{char}</span>
                ))}
              </span>
              <span class="hero-statement" aria-label={zh ? '声音 在腕上' : 'Sound on your wrist'}>
                {zh ? (
                  <span class="kinetic-phrase">
                    <span class="char-unit" style="--bounce-delay: 0ms">声</span><span class="char-unit" style="--bounce-delay: 120ms">音</span><span class="word-spacer" aria-hidden="true">&nbsp;&nbsp;</span><span class="char-unit wave" style="--bounce-delay: 520ms">在</span><span class="char-unit wave" style="--bounce-delay: 560ms">腕</span><span class="char-unit wave" style="--bounce-delay: 600ms">上</span>
                  </span>
                ) : (
                  <span class="kinetic-phrase">
                    <span class="char-unit" style="--bounce-delay: 0ms">Sound</span>
                    <span class="word-spacer" aria-hidden="true">&nbsp;</span>
                    <span class="char-unit wave" style="--bounce-delay: 520ms">on</span>
                    <span class="word-spacer" aria-hidden="true">&nbsp;</span>
                    <span class="char-unit wave" style="--bounce-delay: 560ms">your</span>
                    <span class="word-spacer" aria-hidden="true">&nbsp;</span>
                    <span class="char-unit wave" style="--bounce-delay: 600ms">wrist</span>
                  </span>
                )}
              </span>
            </h1>

            <p class="hero-essence">
              {zh
                ? '跨品牌耳机电量与声学控制，一个开源入口。'
                : 'Cross-brand earbud battery and acoustic control, unified in one open-source app.'}
            </p>

            <div class="action-row">
              <a class="button button-primary" data-arrow="down" href={pagePath(locale, 'project')}>
                <span>{zh ? '获取安装包' : 'Get WearEars'}</span>
                <span class="btn-arrow" aria-hidden="true">↓</span>
              </a>
              <a class="button button-outline" href={pagePath(locale, 'compatibility')}>
                <span>{zh ? '查询耳机型号' : 'Device index'}</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
              <a class="text-link" href={pagePath(locale, 'developers')}>
                {zh ? '探索架构' : 'Architecture'} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <figure class="specimen-plate">
            <div class="specimen-plate-stage">
              <AnimatedAppIcon size={380} />
            </div>
            <figcaption class="specimen-plate-caption">
              <span class="specimen-caption-left">
                <span class="chroma-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <span>FIG. 01 · 45° CHASSIS</span>
              </span>
              <button
                type="button"
                class="specimen-replay-btn"
                data-icon-replay
                aria-label={zh ? '重播图标构造动画' : 'Replay icon construction animation'}
              >
                <span aria-hidden="true">↻</span>
                <span>{zh ? '重绘' : 'REPLAY'}</span>
              </button>
            </figcaption>
          </figure>
        </div>

        <div class="hero-meta">
          <div>
            <span class="label">{zh ? '运行平台' : 'PLATFORMS'}</span>
            <strong>Watch · Phone · Win · HUD</strong>
          </div>
          <div>
            <span class="label">{zh ? '真机基线' : 'VERIFIED'}</span>
            <strong>
              <span class="live-dot green" aria-hidden="true"></span>
              {zh ? `${verifiedCount}款型号 · 9大品牌驱动` : `${verifiedCount} models · 9 brand drivers`}
            </strong>
          </div>
          <div>
            <span class="label">{zh ? '通信边界' : 'PRIVACY'}</span>
            <strong>{zh ? '纯本地蓝牙 · 零联网' : 'Local BT · Zero cloud'}</strong>
          </div>
          <a href={currentRelease?.url ?? releasesUrl} target="_blank" rel="noopener noreferrer">
            <span class="label">{zh ? '公开发布' : 'RELEASE'}</span>
            <strong>
              <span class={`live-dot ${currentRelease?.prerelease ? 'yellow' : 'green'}`} aria-hidden="true"></span>
              {currentRelease?.tag ?? (zh ? '查看发布' : 'View releases')} <span aria-hidden="true">↗</span>
              <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
            </strong>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="1" aria-labelledby="capabilities-title">
    <div class="deck-card deck-paper deck-fan-right">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell section-band-tight">
        <div class="section-header-bar" data-reveal>
          <div>
            <p class="label"><span class="label-mark"></span>01 / CAPABILITIES</p>
            <h2 id="capabilities-title">{zh ? '常用控制，抬腕可达' : 'Essential controls within reach'}</h2>
          </div>
          <a class="text-link" href={pagePath(locale, 'compatibility')}>
            {zh ? `查看全部${totalCount}条设备记录` : `Browse all ${totalCount} device records`} <span aria-hidden="true">→</span>
          </a>
        </div>

        <ol class="matrix-wall">
          {matrixItems.map((item, idx) => (
            <li class="matrix-cell" style={`--cell-accent: ${item.accent};`}>
              <div>
                <div class="matrix-cell-top">
                  <span class="matrix-num">0{idx + 1}</span>
                  <span class="matrix-state">
                    <span class={`live-dot ${item.dot}`} aria-hidden="true"></span>
                    {item.state}
                  </span>
                </div>
                <h3 style="margin-top: 1.1rem;">{item.title}</h3>
              </div>
              <ul class="matrix-tokens">
                {item.tokens.map((tok) => <li>{tok}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="specimen-title">
    <div class="deck-card deck-sunk deck-fan-left">
      <FallingTiles primary="yellow" secondary="blue" />
      <AcousticSpecimen locale={locale} />
    </div>
  </section>

  <section class="slide-section deck-sheet ink-section" data-slide data-slide-index="3" aria-labelledby="architecture-title">
    <div class="deck-card deck-ink deck-fan-right ink-chamber">
      <FallingTiles primary="blue" secondary="red" />
      <div class="shell section-band-tight architecture-grid">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark"></span>03 / SYSTEM DESIGN</p>
          <h2 id="architecture-title">{zh ? '界面统一，驱动独立' : 'One interface. Independent drivers'}</h2>
          <p>
            {zh
              ? '四层解耦，探测确认能力后再开放写入。'
              : 'Four decoupled layers. Features unlock only after capability replies.'}
          </p>
          <div class="chamber-metrics chamber-metrics-4">
            <div><strong>4</strong><span>{zh ? '模块分层' : 'Layers'}</span></div>
            <div><strong>9</strong><span>{zh ? '品牌驱动' : 'Drivers'}</span></div>
            <div><strong>275+</strong><span>{zh ? '离线单测' : 'Tests'}</span></div>
            <div><strong>0</strong><span>{zh ? '云端请求' : 'Cloud'}</span></div>
          </div>
          <a class="text-link" href={pagePath(locale, 'developers')}>
            {zh ? '阅读开发者指南' : 'Read the developer guide'} <span aria-hidden="true">→</span>
          </a>
        </div>
        <Architecture locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="4" aria-labelledby="audience-title">
    <div class="deck-card deck-paper deck-fan-left">
      <FallingTiles primary="red" secondary="green" />
      <div class="shell section-band-tight">
        <div class="section-header-bar" data-reveal>
          <div>
            <p class="label"><span class="label-mark red"></span>04 / START HERE</p>
            <h2 id="audience-title">{zh ? '从这里开始' : 'Find your starting point'}</h2>
          </div>
        </div>

        <div class="audience-grid">
          <article class="consumer-panel">
            <div>
              <p class="label">01 / DOWNLOAD</p>
              <h3>{zh ? '获取安装包' : 'Get WearEars'}</h3>
              <p>{zh ? 'Android多端同包APK · Windows 22.5MB独立单文件托盘版' : 'Unified Android APK · Standalone 22.5 MB Windows tray EXE'}</p>
              <div class="action-row">
                <a class="button button-paper" data-arrow="down" href={site.directDownloadUrl} rel="noopener noreferrer">
                  <span>{zh ? 'Android直连' : 'Android APK'}</span>
                  <span class="btn-arrow" aria-hidden="true">↓</span>
                </a>
                <a class="button button-ink-outline" data-arrow="down" href={site.windowsDownloadUrl} target="_blank" rel="noopener noreferrer">
                  <span>{zh ? 'Windows单文件' : 'Windows EXE'}</span>
                  <span class="btn-arrow" aria-hidden="true">↓</span>
                  <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
                </a>
                <a class="button button-ink-outline" href={pagePath(locale, 'project')}>
                  <span>{zh ? '安装说明' : 'Install guide'}</span>
                  <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
            <a class="panel-star-link" href={site.appRepository} target="_blank" rel="noopener noreferrer">
              <span>{zh ? '能去GitHub上给作者点颗小星星吗' : 'Drop a Star on GitHub'}</span>
              <span aria-hidden="true">↗</span>
              <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
            </a>
          </article>

          <div class="audience-rail">
            <article class="rail-accent-green">
              <div>
                <p class="label"><span class="label-mark green"></span>02 / COMPATIBILITY</p>
                <h3>{zh ? '型号与证据表' : 'Device index'}</h3>
                <p>{zh ? `${verifiedCount}款真机基线 · ${totalCount}条公开记录` : `${verifiedCount} hardware baselines · ${totalCount} public records`}</p>
                <div class="ratio-bar" aria-hidden="true">
                  <span class="ratio-bar-verified" style={`width: ${verifiedPct}%;`}></span>
                  <span class="ratio-bar-candidate" style={`width: ${100 - verifiedPct}%;`}></span>
                </div>
              </div>
              <a class="text-link" href={pagePath(locale, 'compatibility')}>
                {zh ? '查询兼容性' : 'Check compatibility'} <span aria-hidden="true">→</span>
              </a>
            </article>

            <article class="rail-accent-yellow">
              <div>
                <p class="label"><span class="label-mark yellow"></span>03 / DEVELOPERS &amp; PARTNERS</p>
                <h3>{zh ? '源码、裁剪与联合验证' : 'Source, trimming & validation'}</h3>
                <p>{zh ? 'app · core · drivers · Windows离线构建' : 'app · core · drivers · Offline Windows build'}</p>
              </div>
              <div class="rail-links">
                <a class="text-link" href={pagePath(locale, 'developers')}>
                  {zh ? '开发者入口' : 'Developers'} <span aria-hidden="true">→</span>
                </a>
                <a class="text-link" href={pagePath(locale, 'partners')}>
                  {zh ? '厂商合作' : 'Partners'} <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="5" aria-labelledby="journal-title">
    <div class="deck-card deck-paper deck-fan-right">
      <FallingTiles primary="yellow" secondary="blue" />
      <div class="shell section-band-tight journal-section">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark"></span>05 / JOURNAL</p>
          <h2 id="journal-title">{zh ? '项目动态' : 'Project journal'}</h2>
          <p>{zh ? 'GitHub发布记录与协议技术笔记。' : 'GitHub releases and notes from protocol development.'}</p>
          <a class="text-link" href={pagePath(locale, 'blog')}>
            {zh ? '查看全部动态' : 'See the journal'} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ReleaseFeed locale={locale} limit={3} />
      </div>
    </div>
  </section>
</FanDeck>
