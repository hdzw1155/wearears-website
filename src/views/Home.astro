---
import AnimatedAppIcon from '../components/AnimatedAppIcon.astro';
import Architecture from '../components/Architecture.astro';
import ReleaseFeed from '../components/ReleaseFeed.astro';
import releases from '../data/releases.json';
import { pagePath, releasesUrl, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const currentRelease = releases.find((release) => !release.prerelease);
const capabilities = zh ? [
  { title: '电量读取', body: '查看耳机实际提供的左右耳、充电盒或整机电量。', state: '已实现' },
  { title: '声学控制', body: '在支持的型号上切换降噪、关闭和通透。', state: '按型号' },
  { title: '跨品牌适配', body: '查找具体型号的能力范围、实测记录和协议候选。', state: '公开记录' },
  { title: '可扩展驱动', body: '通过统一接口接入新驱动，复用已有的腕上操作。', state: '已实现' },
] : [
  { title: 'Battery awareness', body: 'See left, right, case or aggregate battery as reported by the earbuds.', state: 'Implemented' },
  { title: 'Acoustic control', body: 'Switch between noise cancellation, off and transparency on supported models.', state: 'By model' },
  { title: 'Cross-brand compatibility', body: 'Find device capabilities, hardware records and protocol candidates by model.', state: 'Public records' },
  { title: 'Extensible drivers', body: 'Add drivers through a shared interface and reuse the controls on the watch.', state: 'Implemented' },
];
const heroLetters = ['W', 'e', 'a', 'r', 'E', 'a', 'r', 's'];
---

<div class="home-deck">
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-labelledby="hero-title">
    <div class="deck-card deck-card-hero">
      <div class="falling-tile-track" aria-hidden="true">
        <span class="falling-tile tile-yellow"></span>
        <span class="falling-tile tile-mini tile-blue"></span>
      </div>
      <div class="hero shell">
        <div class="hero-index label">
          <span><i class="label-mark" aria-hidden="true"></i> INDEPENDENT WEARABLE AUDIO</span>
          <span class="hero-index-side">WEAR OS <span class="hero-cross">×</span> TWS</span>
        </div>
        <div class="hero-stage">
          <div class="hero-copy">
            <h1 id="hero-title">
              <span class="hero-name" aria-label="WearEars">
                {heroLetters.map((char, idx) => (
                  <span
                    aria-hidden="true"
                    class={`hero-letter${idx === heroLetters.length - 1 ? ' hero-letter-s' : ''}`}
                    data-letter-idx={idx}
                  >{char}</span>
                ))}
              </span>
              <span class="hero-statement" aria-label={zh ? '声音 在腕上' : 'Sound on your wrist'}>
                {zh ? (
                  <span class="kinetic-phrase">
                    <span class="char-unit" style="--bounce-delay: 0ms">声</span><span class="char-unit" style="--bounce-delay: 120ms">音</span><span class="word-spacer" aria-hidden="true">&nbsp;&nbsp;</span><span class="char-unit wave" style="--bounce-delay: 520ms">在</span><span class="char-unit wave" style="--bounce-delay: 560ms">腕</span><span class="char-unit wave" style="--bounce-delay: 600ms">上</span>
                  </span>
                ) : (
                  <span class="kinetic-phrase">
                    <span class="char-unit" style="--bounce-delay: 0ms">Sound</span>
                    <span class="word-spacer" aria-hidden="true">&nbsp;</span>
                    <span class="char-unit wave" style="--bounce-delay: 520ms">on</span>
                    <span class="word-spacer" aria-hidden="true">&nbsp;</span>
                    <span class="char-unit wave" style="--bounce-delay: 560ms">your</span>
                    <span class="word-spacer" aria-hidden="true">&nbsp;</span>
                    <span class="char-unit wave" style="--bounce-delay: 600ms">wrist</span>
                  </span>
                )}
              </span>
            </h1>
            <p>{zh
              ? '在 Wear OS 手表上查看耳机电量、切换聆听模式。为不同品牌的耳机，提供一个统一的操作入口。'
              : 'Check earbud battery and switch listening modes from a Wear OS watch. One place for everyday controls across brands.'}</p>
            <div class="action-row">
              <a class="button button-primary" href={pagePath(locale, 'project')}>
                {zh ? '了解项目' : 'Explore the project'} <span aria-hidden="true">→</span>
              </a>
              <a class="button button-outline" href={pagePath(locale, 'developers')}>
                {zh ? '探索技术' : 'Explore the technology'} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
          <figure class="hero-figure">
            <AnimatedAppIcon size={520} />
            <figcaption>FIG. 01 <span></span> WEAREARS ICON</figcaption>
          </figure>
        </div>
        <div class="hero-meta">
          <div><span class="label">{zh ? '平台' : 'Platform'}</span><strong>Wear OS</strong></div>
          <div><span class="label">{zh ? '方法' : 'Approach'}</span><strong>{zh ? '开源驱动' : 'Open-source drivers'}</strong></div>
          <a href={currentRelease?.url ?? releasesUrl} target="_blank" rel="noopener noreferrer">
            <span class="label">{zh ? '公开发布' : 'Public release'}</span>
            <strong>{currentRelease?.tag ?? (zh ? '查看发布' : 'View releases')} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span></strong>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="1" aria-labelledby="capabilities-title">
    <div class="deck-card deck-paper deck-fan-right">
      <div class="falling-tile-track" aria-hidden="true">
        <span class="falling-tile tile-green"></span>
        <span class="falling-tile tile-mini tile-yellow"></span>
      </div>
      <div class="shell section-space capability-section">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>01 / PROJECT</p>
          <h2 id="capabilities-title">{zh ? '常用控制 抬腕可达' : 'Everyday controls within reach'}</h2>
          <p>{zh
            ? 'WearEars 把不同耳机的常用操作放进同一套手表界面。连接后可用的功能，由具体耳机和驱动决定。'
            : 'WearEars brings familiar earbud controls into one watch interface. The model and its driver determine which controls are available.'}</p>
          <a class="text-link" href={pagePath(locale, 'compatibility')}>{zh ? '查询耳机型号' : 'Find your model'} <span aria-hidden="true">→</span></a>
        </div>
        <ol class="capability-list">
          {capabilities.map((entry, index) => (
            <li>
              <span class="entry-index" aria-hidden="true">0{index + 1}</span>
              <div>
                <h3>{entry.title}</h3>
                <p>{entry.body}</p>
              </div>
              <span class="status-tag">{entry.state}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet ink-section" data-slide data-slide-index="2" aria-labelledby="architecture-title">
    <div class="deck-card deck-ink deck-fan-left section-space">
      <div class="falling-tile-track" aria-hidden="true">
        <span class="falling-tile tile-blue"></span>
        <span class="falling-tile tile-mini tile-red"></span>
      </div>
      <div class="shell architecture-grid">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>02 / SYSTEM DESIGN</p>
          <h2 id="architecture-title">{zh ? '界面统一 驱动独立' : 'One interface. Independent drivers'}</h2>
          <p>{zh
            ? '从手表上的一次点击，到耳机的状态回报，四层结构各自承担清晰的职责。'
            : 'Four layers give each step a clear role, from a tap on the watch to a state report from the earbuds.'}</p>
          <a class="text-link" href={pagePath(locale, 'developers')}>{zh ? '阅读开发者指南' : 'Read the developer guide'} <span aria-hidden="true">→</span></a>
        </div>
        <Architecture locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet deck-audience" data-slide data-slide-index="3" aria-labelledby="audience-title">
    <div class="deck-card deck-paper deck-fan-right">
      <div class="falling-tile-track" aria-hidden="true">
        <span class="falling-tile tile-red"></span>
        <span class="falling-tile tile-mini tile-green"></span>
      </div>
      <div class="shell section-space">
        <div class="section-heading">
          <p class="label"><span class="label-mark"></span>03 / EXPLORE</p>
          <h2 id="audience-title">{zh ? '从这里开始' : 'Find your starting point'}</h2>
        </div>
        <div class="audience-grid">
          <article class="consumer-panel">
            <p class="label">01 / LISTENERS</p>
            <h3>{zh ? '为你的耳机找到答案' : 'Find what works with your earbuds'}</h3>
            <p>{zh ? '查看型号记录，确认支持的功能，再到 GitHub 获取手表应用。' : 'Check the record for your model, then get the watch app from GitHub.'}</p>
            <a class="button button-paper" href={pagePath(locale, 'compatibility')}>{zh ? '查询兼容性' : 'Check compatibility'} <span aria-hidden="true">→</span></a>
          </article>
          <div class="audience-rail">
            <article>
              <p class="label"><span class="label-mark green"></span>02 / DEVELOPERS</p>
              <h3>{zh ? '从协议到驱动' : 'From protocol to driver'}</h3>
              <p>{zh ? '阅读接口、匹配规则与验证方法，参与设备适配。' : 'Read the contract, matching rules and evidence workflow to contribute a driver.'}</p>
              <a class="text-link" href={pagePath(locale, 'developers')}>{zh ? '开发者入口' : 'Developer resources'} <span aria-hidden="true">→</span></a>
            </article>
            <article>
              <p class="label"><span class="label-mark yellow"></span>03 / PARTNERS</p>
              <h3>{zh ? '一起验证更多设备' : 'Validate more devices together'}</h3>
              <p>{zh ? '围绕型号、固件与目标能力，探讨联合验证和驱动适配。' : 'Explore joint validation and driver adaptation around specific models, firmware and capabilities.'}</p>
              <a class="text-link" href={pagePath(locale, 'partners')}>{zh ? '了解合作' : 'Explore collaboration'} <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet deck-journal" data-slide data-slide-index="4" aria-labelledby="journal-title">
    <div class="deck-card deck-paper deck-fan-left">
      <div class="falling-tile-track" aria-hidden="true">
        <span class="falling-tile tile-yellow"></span>
        <span class="falling-tile tile-mini tile-blue"></span>
      </div>
      <div class="shell section-space journal-section">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>04 / JOURNAL</p>
          <h2 id="journal-title">{zh ? '项目动态' : 'Project journal'}</h2>
          <p>{zh ? 'GitHub 发布记录与协议技术笔记。' : 'GitHub releases and notes from protocol development.'}</p>
          <a class="text-link" href={pagePath(locale, 'blog')}>{zh ? '查看全部动态' : 'See the journal'} <span aria-hidden="true">→</span></a>
        </div>
        <ReleaseFeed locale={locale} limit={3} />
      </div>
    </div>
  </section>
</div>

<script>
  (() => {
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.home-deck > .slide-section'));
    if (slides.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Dynamic sticky top offsets so tall sections scroll fully before pinning
    const syncStickyOffsets = () => {
      const vh = window.innerHeight || document.documentElement.clientHeight;
      for (const slide of slides) {
        const h = slide.offsetHeight;
        const topOffset = h > vh ? Math.round(vh - h) : 0;
        slide.style.top = `${topOffset}px`;
      }
    };

    syncStickyOffsets();
    window.addEventListener('resize', syncStickyOffsets, { passive: true });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(syncStickyOffsets);
      slides.forEach((s) => ro.observe(s));
    }

    // 2. Replay entrance safely without hiding visible content on screen
    const retriggerSlide = (slide: HTMLElement) => {
      slide.classList.remove('is-waiting');
      slide.classList.remove('is-active');
      void slide.offsetWidth;
      slide.classList.add('is-active');
    };

    const vhInit = window.innerHeight || document.documentElement.clientHeight;
    slides.forEach((slide, idx) => {
      const r = slide.getBoundingClientRect();
      if (idx > 0 && r.top >= vhInit - 16) {
        slide.classList.add('is-waiting');
      } else {
        slide.classList.add('is-active');
      }
    });

    // 3. Scroll-driven alternating folding-fan deck transitions & cover state tracking
    const cards = slides.map((s) => s.querySelector<HTMLElement>('.deck-card'));
    let rafId = 0;
    const updateDeckState = () => {
      rafId = 0;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const vw = window.innerWidth || document.documentElement.clientWidth;
      const shellW = Math.min(vw - Math.max(38.4, Math.min(vw * 0.08, 115.2)), 1248);
      const gutterPx = Math.max(16, (vw - shellW) * 0.5);
      const safeMidDeg = (Math.max(8, gutterPx - 3) / Math.max(480, vh * 0.72)) * (180 / Math.PI);
      const maxAngle = Math.min(10.5, Math.max(2.6, safeMidDeg * 2));
      const shiftFactor = Math.max(0, Math.min(1, (gutterPx - 24) / 56));
      const maxShiftVw = 2.6 * shiftFactor;
      const maxOutAngle = Math.min(2.5, maxAngle * 0.28);
      const enterSpan = vh * 0.88;

      for (let i = 0; i < slides.length; i++) {
        const slide = slides[i];
        const card = cards[i];
        const rect = slide.getBoundingClientRect();
        const nextSlide = i < slides.length - 1 ? slides[i + 1] : null;
        const nextRect = nextSlide ? nextSlide.getBoundingClientRect() : null;

        // Frosted sheet solidifies cleanly as its top approaches viewport top (0px)
        const settledTarget = card || slide;
        if (i > 0) {
          const rawSettled = 1 - Math.max(0, Math.min(rect.top, vh * 0.45)) / (vh * 0.45);
          settledTarget.style.setProperty('--settled', rawSettled.toFixed(3));
        }

        // Under-sheet gentle blur as incoming sheet slides up over it
        const cover = nextRect ? 1 - Math.max(0, Math.min(nextRect.top, vh)) / vh : 0;
        if (nextRect) {
          slide.style.setProperty('--buried', cover.toFixed(3));
        }

        if (card) {
          if (reducedMotion) {
            card.style.setProperty('--fan-rot', '0deg');
            card.style.setProperty('--fan-x', '0vw');
            card.style.setProperty('--fan-scale', '1');
          } else {
            let angle = 0;
            let shiftVw = 0;
            let scale = 1;

            if (i > 0) {
              const inDir = i % 2 === 1 ? 1 : -1;
              const tIn = Math.max(0, Math.min(1, (vh - rect.top) / enterSpan));
              const remIn = 0.5 * (1 + Math.cos(Math.PI * tIn));
              angle += inDir * maxAngle * remIn;
              shiftVw += inDir * maxShiftVw * remIn;
              scale *= 1 - 0.045 * remIn;
            }

            if (nextRect && cover > 0) {
              const outDir = i % 2 === 0 ? -1 : 1;
              const tallDamp = slide.offsetHeight > vh * 1.15 ? 0.55 : 1;
              const coverEase = 0.5 * (1 - Math.cos(Math.PI * cover));
              angle += outDir * maxOutAngle * tallDamp * coverEase;
              scale *= 1 - 0.032 * tallDamp * coverEase;
            }

            card.style.setProperty('--fan-rot', `${angle.toFixed(2)}deg`);
            card.style.setProperty('--fan-x', `${shiftVw.toFixed(2)}vw`);
            card.style.setProperty('--fan-scale', scale.toFixed(4));
          }
        }

        const isBuried = Boolean(nextRect && nextRect.top <= 18);
        if (isBuried) {
          slide.dataset.buried = '1';
        } else if (slide.dataset.buried === '1' && (!nextRect || nextRect.top > vh * 0.25)) {
          delete slide.dataset.buried;
          retriggerSlide(slide);
          if (i === 0) scheduleIntroHop();
        }

        // Trigger waiting slides when entering from bottom
        if (rect.top < vh * 0.88 && !slide.classList.contains('is-active')) {
          retriggerSlide(slide);
        }

        // Only reset to waiting if completely offscreen below the viewport
        if (i > 0 && rect.top >= vh + 24 && slide.classList.contains('is-active')) {
          slide.classList.remove('is-active');
          slide.classList.add('is-waiting');
        }
      }
    };

    const scheduleDeckUpdate = () => {
      if (!rafId) rafId = window.requestAnimationFrame(updateDeckState);
    };

    window.addEventListener('scroll', scheduleDeckUpdate, { passive: true });
    window.addEventListener('resize', scheduleDeckUpdate, { passive: true });
    updateDeckState();

    // 4. Living "s" character easter egg in WearEars wordmark
    const heroSlide = slides[0];
    const sEl = heroSlide.querySelector<HTMLElement>('.hero-letter-s');
    const allLetters = Array.from(heroSlide.querySelectorAll<HTMLElement>('.hero-letter'));
    const siblingLetters = allLetters.slice(0, -1).reverse(); // r, a, E, r, a, e, W

    if (!sEl || siblingLetters.length === 0 || reducedMotion) return;

    let scriptRunId = 0;
    let idleTimerId: number | null = null;
    let introHopTimerId: number | null = null;
    let isIdleRunning = false;
    let isRecovering = false;
    let hasFinishedTour = false;
    let activeAnimations: Animation[] = [];

    const clearAnimations = () => {
      activeAnimations.forEach((a) => {
        try { a.cancel(); } catch {}
      });
      activeAnimations = [];
    };

    const waitMs = (ms: number, runId: number) =>
      new Promise<boolean>((resolve) => {
        window.setTimeout(() => resolve(runId === scriptRunId), ms);
      });

    const playAnim = (
      el: HTMLElement,
      keyframes: Keyframe[],
      options: KeyframeAnimationOptions,
      runId: number
    ) =>
      new Promise<boolean>((resolve) => {
        if (runId !== scriptRunId) return resolve(false);
        const anim = el.animate(keyframes, options);
        activeAnimations.push(anim);
        anim.onfinish = () => {
          activeAnimations = activeAnimations.filter((a) => a !== anim);
          if (runId === scriptRunId && options.fill === 'forwards') {
            const last = keyframes[keyframes.length - 1];
            if (last && typeof last.transform === 'string') {
              el.style.transform = last.transform;
            }
            try { anim.cancel(); } catch {}
          }
          resolve(runId === scriptRunId);
        };
        anim.oncancel = () => {
          activeAnimations = activeAnimations.filter((a) => a !== anim);
          resolve(false);
        };
      });

    const isHeroFocused = () => {
      const heroRect = heroSlide.getBoundingClientRect();
      const nextRect = slides[1] ? slides[1].getBoundingClientRect() : null;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const notCovered = !nextRect || nextRect.top > vh * 0.45;
      return !document.hidden && heroRect.bottom > vh * 0.5 && notCovered;
    };

    const playIntroHop = () => {
      if (!isHeroFocused() || isIdleRunning) return;
      // 水滴弹跳质感：表面张力微压 → 水滴纵向拉长腾空 → 软落回弹一次微颤
      sEl.animate(
        [
          { transform: 'translate3d(0, 0, 0) scale(1, 1)', offset: 0 },
          { transform: 'translate3d(0, 2px, 0) scale(1.13, 0.85)', offset: 0.15 },
          { transform: 'translate3d(0, -23px, 0) scale(0.88, 1.15)', offset: 0.44 },
          { transform: 'translate3d(0, 2px, 0) scale(1.14, 0.84)', offset: 0.72 },
          { transform: 'translate3d(0, -5px, 0) scale(0.95, 1.06)', offset: 0.86 },
          { transform: 'translate3d(0, 0, 0) scale(1, 1)', offset: 1 }
        ],
        { duration: 580, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
      );
    };

    function scheduleIntroHop() {
      if (introHopTimerId !== null) window.clearTimeout(introHopTimerId);
      // “快慢刀”延迟：待文字波浪(920ms)与图标4阶段绘制(1080ms)彻底静止约640ms后再水滴弹跳
      introHopTimerId = window.setTimeout(() => {
        introHopTimerId = null;
        playIntroHop();
      }, 1720);
    }

    const startIdleMonitor = () => {
      if (idleTimerId !== null) window.clearTimeout(idleTimerId);
      idleTimerId = window.setTimeout(() => {
        idleTimerId = null;
        if (isHeroFocused() && !isIdleRunning) {
          void runIdleChoreography();
        }
      }, 5800);
    };

    const disturbLetter = async (letter: HTMLElement, runId: number) => {
      letter.style.zIndex = '3';
      // 1) 伸缩两下（“咳咳”，温和提示）
      const ok1 = await playAnim(
        letter,
        [
          { transform: 'translate3d(0, 0, 0) scale(1, 1)', offset: 0 },
          { transform: 'translate3d(0, 1px, 0) scale(1.06, 0.90)', offset: 0.22 },
          { transform: 'translate3d(0, -1px, 0) scale(0.97, 1.04)', offset: 0.48 },
          { transform: 'translate3d(0, 1px, 0) scale(1.06, 0.90)', offset: 0.74 },
          { transform: 'translate3d(0, 0, 0) scale(0.99, 1.02)', offset: 1 }
        ],
        { duration: 440, easing: 'ease-in-out' },
        runId
      );
      if (!ok1) {
        letter.style.zIndex = '';
        return false;
      }

      // 2) 挺起腰放大一会后缩小回原来，然后静止不动
      const ok2 = await playAnim(
        letter,
        [
          { transform: 'translate3d(0, 0, 0) scale(1, 1)', offset: 0 },
          { transform: 'translate3d(0, -5px, 0) scale(1.11, 1.16)', offset: 0.28 },
          { transform: 'translate3d(0, -4px, 0) scale(1.11, 1.16)', offset: 0.70 },
          { transform: 'translate3d(0, 0, 0) scale(1, 1)', offset: 1 }
        ],
        { duration: 920, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        runId
      );
      letter.style.zIndex = '';
      return ok2;
    };

    const runIdleChoreography = async () => {
      const runId = ++scriptRunId;
      isIdleRunning = true;
      sEl.style.zIndex = '4';

      let curX = 0;

      const lookAround = async (xBase: number, slow = false) => {
        const durLook = slow ? 1950 : 1650;
        if (!(await playAnim(
          sEl,
          [
            { transform: `translate3d(${xBase}px, 0, 0) rotate(0deg) scale(0.97, 1.03)`, offset: 0 },
            { transform: `translate3d(${xBase - 2}px, 0, 0) rotate(-14deg) scale(0.97, 1.03)`, offset: 0.18 },
            { transform: `translate3d(${xBase - 2}px, 0, 0) rotate(-14deg) scale(0.97, 1.03)`, offset: 0.36 },
            { transform: `translate3d(${xBase + 2}px, 0, 0) rotate(13deg) scale(0.97, 1.03)`, offset: 0.56 },
            { transform: `translate3d(${xBase + 2}px, 0, 0) rotate(13deg) scale(0.97, 1.03)`, offset: 0.74 },
            { transform: `translate3d(${xBase}px, -4px, 0) rotate(-3deg) scale(0.96, 1.05)`, offset: 0.87 },
            { transform: `translate3d(${xBase}px, 0, 0) rotate(0deg) scale(1, 1)`, offset: 1 }
          ],
          { duration: durLook, easing: 'ease-in-out', fill: 'forwards' },
          runId
        ))) return false;
        return true;
      };

      const lazyStretch = async (xBase: number) => {
        // 躲在最后面发呆：伸个懒腰并弯曲一下身子
        return playAnim(
          sEl,
          [
            { transform: `translate3d(${xBase}px, 0, 0) rotate(0deg) skewX(0deg) scale(1, 1)`, offset: 0 },
            { transform: `translate3d(${xBase - 1}px, -4px, 0) rotate(-9deg) skewX(-6deg) scale(0.93, 1.11)`, offset: 0.30 },
            { transform: `translate3d(${xBase - 1}px, -4px, 0) rotate(-9deg) skewX(-6deg) scale(0.93, 1.11)`, offset: 0.52 },
            { transform: `translate3d(${xBase + 2}px, 1px, 0) rotate(7deg) skewX(5deg) scale(1.04, 0.94)`, offset: 0.78 },
            { transform: `translate3d(${xBase}px, 0, 0) rotate(0deg) skewX(0deg) scale(1, 1)`, offset: 1 }
          ],
          { duration: 1900, easing: 'ease-in-out', fill: 'forwards' },
          runId
        );
      };

      if (!hasFinishedTour) {
        // 1) 再水滴弹一下，变得像人
        if (!(await playAnim(
          sEl,
          [
            { transform: 'translate3d(0, 0, 0) scale(1, 1)', offset: 0 },
            { transform: 'translate3d(0, 2px, 0) scale(1.12, 0.86)', offset: 0.16 },
            { transform: 'translate3d(0, -24px, 0) scale(0.89, 1.13)', offset: 0.46 },
            { transform: 'translate3d(0, 2px, 0) scale(1.08, 0.92)', offset: 0.78 },
            { transform: 'translate3d(0, 0, 0) scale(0.98, 1.03)', offset: 1 }
          ],
          { duration: 560, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' },
          runId
        ))) return;

        // 2) 左顾右盼 + 上下张望 + 轻晃身子
        if (!(await lookAround(0))) return;
        if (!(await playAnim(
          sEl,
          [
            { transform: 'translate3d(0, 0, 0) rotate(0deg)', offset: 0 },
            { transform: 'translate3d(-2px, -2px, 0) rotate(-10deg)', offset: 0.3 },
            { transform: 'translate3d(2px, -2px, 0) rotate(10deg)', offset: 0.65 },
            { transform: 'translate3d(0, 0, 0) rotate(0deg)', offset: 1 }
          ],
          { duration: 720, easing: 'ease-in-out', fill: 'forwards' },
          runId
        ))) return;
        if (!(await waitMs(320, runId))) return;

        // 3) 第一轮：放慢节奏挨个找大家“交流”（仅一轮）
        const sCenter = sEl.offsetLeft + sEl.offsetWidth * 0.5;
        for (let idx = 0; idx < siblingLetters.length; idx++) {
          if (runId !== scriptRunId || !isHeroFocused()) return;
          const target = siblingLetters[idx];
          const standbyX = Math.round(
            target.offsetLeft + target.offsetWidth + sEl.offsetWidth * 0.18 - sCenter
          );
          const midX = Math.round((curX + standbyX) * 0.5);
          const dist = Math.abs(standbyX - curX);
          const travelMs = Math.max(420, Math.min(680, dist * 2.8 + 300));
          const leanDir = standbyX < curX ? -10 : 10;

          // 舒缓跳过去找对方
          if (!(await playAnim(
            sEl,
            [
              { transform: `translate3d(${curX}px, 0, 0) rotate(0deg)`, offset: 0 },
              { transform: `translate3d(${midX}px, -13px, 0) rotate(${leanDir}deg) scale(0.95, 1.06)`, offset: 0.5 },
              { transform: `translate3d(${standbyX}px, 0, 0) rotate(0deg) scale(1.04, 0.96)`, offset: 0.88 },
              { transform: `translate3d(${standbyX}px, 0, 0) rotate(0deg) scale(1, 1)`, offset: 1 }
            ],
            { duration: travelMs, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' },
            runId
          ))) return;
          curX = standbyX;
          if (!(await waitMs(180, runId))) return;

          // 温和地敲一敲、点头打招呼“交流”
          if (!(await playAnim(
            sEl,
            [
              { transform: `translate3d(${curX}px, 0, 0) rotate(0deg)`, offset: 0 },
              { transform: `translate3d(${curX - 7}px, -2px, 0) rotate(-14deg)`, offset: 0.28 },
              { transform: `translate3d(${curX + 2}px, 0, 0) rotate(4deg)`, offset: 0.54 },
              { transform: `translate3d(${curX - 7}px, -2px, 0) rotate(-14deg)`, offset: 0.78 },
              { transform: `translate3d(${curX}px, 0, 0) rotate(0deg)`, offset: 1 }
            ],
            { duration: 600, easing: 'ease-in-out', fill: 'forwards' },
            runId
          ))) return;
          if (!(await waitMs(140, runId))) return;

          // 对方“咳咳”两声并挺腰回应
          const okDisturb = await disturbLetter(target, runId);
          if (!okDisturb) return;

          if (!(await waitMs(380, runId))) return;
        }

        // 第一轮交流结束，慢慢溜达回最后面自己的位置
        if (!(await playAnim(
          sEl,
          [
            { transform: `translate3d(${curX}px, 0, 0) rotate(0deg)`, offset: 0 },
            { transform: `translate3d(${Math.round(curX * 0.5)}px, -14px, 0) rotate(12deg)`, offset: 0.5 },
            { transform: 'translate3d(2px, 0, 0) rotate(0deg)', offset: 1 }
          ],
          { duration: 680, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' },
          runId
        ))) return;
        curX = 2;
        hasFinishedTour = true;
        if (!(await waitMs(1400, runId))) return;
      }

      // 4) 之后不再去找别人，只会一个人躲在最后面发呆（时不时东张西望、伸懒腰弯曲身子）
      curX = 2;
      let cycle = 0;
      while (runId === scriptRunId && isHeroFocused()) {
        // 静静发呆一会
        if (!(await waitMs(2400, runId))) return;

        if (cycle % 2 === 0) {
          // 时不时东张西望一下
          if (!(await lookAround(curX, true))) return;
        } else {
          // 时不时伸个懒腰、弯曲一下身子
          if (!(await lazyStretch(curX))) return;
        }

        if (!(await waitMs(1600, runId))) return;
        if (cycle % 3 === 1) {
          // 偶尔轻轻晃一下懒腰收尾
          if (!(await playAnim(
            sEl,
            [
              { transform: `translate3d(${curX}px, 0, 0) rotate(0deg)`, offset: 0 },
              { transform: `translate3d(${curX}px, -1px, 0) rotate(-5deg)`, offset: 0.4 },
              { transform: `translate3d(${curX}px, 0, 0) rotate(4deg)`, offset: 0.75 },
              { transform: `translate3d(${curX}px, 0, 0) rotate(0deg)`, offset: 1 }
            ],
            { duration: 900, easing: 'ease-in-out', fill: 'forwards' },
            runId
          ))) return;
        }
        cycle++;
      }
    };

    const hurryBackHome = () => {
      if (!isIdleRunning) {
        startIdleMonitor();
        return;
      }
      scriptRunId++;
      isIdleRunning = false;
      isRecovering = true;

      // Capture live visual transform right before canceling
      const computed = getComputedStyle(sEl).transform;
      let curX = 0;
      let curY = 0;
      if (computed && computed !== 'none') {
        const m = new DOMMatrix(computed);
        curX = m.m41;
        curY = m.m42;
      }

      clearAnimations();
      sEl.style.transform = '';

      // Ease any disturbed letter smoothly back to upright stillness
      siblingLetters.forEach((l) => {
        l.style.zIndex = '';
        const lt = getComputedStyle(l).transform;
        if (lt && lt !== 'none') {
          l.animate(
            [{ transform: lt }, { transform: 'translate3d(0, 0, 0) scale(1, 1)' }],
            { duration: 150, easing: 'ease-out' }
          );
        }
      });

      const dist = Math.abs(curX);
      if (dist <= 6) {
        // 本来就在角落发呆/伸懒腰：立刻一个激灵站直归位
        const snapAnim = sEl.animate(
          [
            { transform: computed && computed !== 'none' ? computed : 'translate3d(0, 0, 0)' },
            { transform: 'translate3d(0, 0, 0) rotate(-3deg) scale(0.95, 1.07)', offset: 0.45 },
            { transform: 'translate3d(0, 0, 0) rotate(0deg) skewX(0deg) scale(1, 1)', offset: 1 }
          ],
          { duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
        );
        snapAnim.onfinish = () => {
          sEl.style.zIndex = '';
          sEl.style.transform = '';
          isRecovering = false;
          startIdleMonitor();
        };
        return;
      }

      const runMs = Math.max(200, Math.min(420, dist * 0.85 + 180));
      const runDir = curX < 0 ? 1 : -1;
      const runAnim = sEl.animate(
        [
          { transform: `translate3d(${curX}px, ${curY}px, 0) rotate(${runDir * 14}deg)`, offset: 0 },
          { transform: `translate3d(${Math.round(curX * 0.65)}px, -7px, 0) rotate(${runDir * 17}deg) scale(0.96, 1.05)`, offset: 0.28 },
          { transform: `translate3d(${Math.round(curX * 0.30)}px, 0px, 0) rotate(${runDir * 15}deg)`, offset: 0.56 },
          { transform: `translate3d(${Math.round(curX * 0.08)}px, -5px, 0) rotate(${runDir * 10}deg)`, offset: 0.78 },
          { transform: 'translate3d(2px, 0, 0) rotate(-5deg) scale(0.95, 1.07)', offset: 0.90 },
          { transform: 'translate3d(0, 0, 0) rotate(0deg) scale(1, 1)', offset: 1 }
        ],
        { duration: runMs, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
      );
      runAnim.onfinish = () => {
        sEl.style.zIndex = '';
        sEl.style.transform = '';
        isRecovering = false;
        startIdleMonitor();
      };
    };

    const onUserActivity = () => {
      if (isIdleRunning) {
        hurryBackHome();
      } else if (!isRecovering) {
        startIdleMonitor();
      }
    };

    ['mousemove', 'pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((evt) => {
      window.addEventListener(evt, onUserActivity, { passive: true });
    });
    window.addEventListener('scroll', onUserActivity, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && isIdleRunning) {
        hurryBackHome();
      }
    });

    scheduleIntroHop();
    startIdleMonitor();
  })();
</script>
