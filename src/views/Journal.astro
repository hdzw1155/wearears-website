---
import FallingTiles from '../components/FallingTiles.astro';
import FanDeck from '../components/FanDeck.astro';
import PageIntro from '../components/PageIntro.astro';
import ReleaseFeed from '../components/ReleaseFeed.astro';
import { appSource, appRevision, releasesUrl, site, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';

const notes = zh ? [
  {
    code: 'DOC / 01',
    title: '下一代底层架构与交接',
    body: '查看Wave 1-5演进、纯JVM领域规则、单端空间音频三层架构与协议安全红线。',
    url: appSource + 'docs/HANDOFF.md',
  },
  {
    code: 'DOC / 02',
    title: '模块化文件导航与改动指南',
    body: '按故障与功能定位app、core、drivers与离线测试文件的对应关系。',
    url: appSource + 'docs/FILE_MAP.md',
  },
  {
    code: 'COMMIT / 03',
    title: 'v0.5.0-exp-C多端与Windows桌面提交',
    body: '查看内网防火墙、独立开发者选项、vivo回执同步与22.5MB Windows单文件托盘端源码提交。',
    url: site.appRepository + '/commit/' + appRevision,
  },
] : [
  {
    code: 'DOC / 01',
    title: 'Architecture & Wave 1-5 Handoff',
    body: 'Pure JVM rules, three-layer local spatial audio, protocol safety guardrails and offline regression baseline.',
    url: appSource + 'docs/HANDOFF.md',
  },
  {
    code: 'DOC / 02',
    title: 'Modular File Map & Maintenance Guide',
    body: 'Navigate app, core, drivers and the offline test suites by symptom or feature lane.',
    url: appSource + 'docs/FILE_MAP.md',
  },
  {
    code: 'COMMIT / 03',
    title: 'v0.5.0-exp-C Multi-Device & Windows Commit',
    body: 'Inspect the commit adding LAN firewall, Developer Options, vivo ACK sync and the standalone Windows tray client.',
    url: site.appRepository + '/commit/' + appRevision,
  },
];
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-label={zh ? '项目动态概述' : 'Journal introduction'}>
    <div class="deck-card deck-card-hero">
      <FallingTiles primary="yellow" secondary="blue" />
      <PageIntro
        label="05 / JOURNAL"
        meta="GITHUB RELEASES · ARCHITECTURE NOTES"
        title={zh ? '沿着公开记录向前' : 'Follow the work in public'}
        summary={zh
          ? '版本发布同步自GitHub Releases。技术笔记直连仓库当前的模块化架构文档、文件导航与真实提交。'
          : 'Releases sync from GitHub Releases. Engineering notes link directly to the modular architecture docs, file map and commits.'}
      />
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="1" aria-labelledby="releases-title">
    <div class="deck-card deck-paper deck-fan-right">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell section-band-tight journal-section">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark green"></span>RELEASES</p>
          <h2 id="releases-title">{zh ? '版本发布' : 'Releases'}</h2>
          <p>{zh ? '发布日期以GitHub为准，按北京时间显示。含正式发布与公开实验预览版。' : 'GitHub publication dates shown in China Standard Time, including stable releases and public previews.'}</p>
          <a class="text-link" href={releasesUrl} target="_blank" rel="noopener noreferrer">
            GitHub Releases <span aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>
        <ReleaseFeed locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="notes-title">
    <div class="deck-card deck-sunk deck-fan-left">
      <FallingTiles primary="red" secondary="blue" />
      <div class="shell section-band-tight">
        <div class="section-header-bar" data-reveal>
          <div>
            <p class="label"><span class="label-mark red"></span>ENGINEERING NOTES</p>
            <h2 id="notes-title">{zh ? '技术笔记' : 'Engineering notes'}</h2>
          </div>
        </div>

        <ul class="note-grid">
          {notes.map((note) => (
            <li>
              <a href={note.url} target="_blank" rel="noopener noreferrer">
                <div>
                  <p class="label">{note.code}</p>
                  <h3 style="margin-top: 0.75rem;">{note.title}</h3>
                  <p>{note.body}</p>
                </div>
                <div class="note-card-foot">
                  <span>GITHUB SOURCE</span>
                  <span aria-hidden="true">↗</span>
                  <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</FanDeck>
