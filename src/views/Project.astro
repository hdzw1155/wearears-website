---
import AnimatedAppIcon from '../components/AnimatedAppIcon.astro';
import DownloadBay from '../components/DownloadBay.astro';
import FallingTiles from '../components/FallingTiles.astro';
import FanDeck from '../components/FanDeck.astro';
import { releasesUrl, site, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';

const specs = zh ? [
  {
    index: '01',
    title: '四端形态，四套皮肤',
    body: '手表、手机、智能眼镜纯黑HUD与Windows 22.5MB独立托盘版统一至上、新极简、新经典与新液位四套视觉，按探测开放细分降噪、抗风噪、EQ、空间音频与查找耳机。',
  },
  {
    index: '02',
    title: '局域网协同与内网防火墙',
    body: '同局域网多端通过4位PIN本地互联，零云端免抢蓝牙通道；「开发者选项」内置应用层内网防火墙（同子网、白名单、只读模式与防爆破封禁），手机端支持空闲快撤短连接。',
  },
  {
    index: '03',
    title: '本机空间音频与安全红线',
    body: '360°双耳HRTF试听实验室支持任意蓝牙耳机，硬件或系统Spatializer开启时自动避让；全端内置70%音量护栏、入耳拦截响铃，局域网远程永久硬禁查找耳机。',
  },
] : [
  {
    index: '01',
    title: 'Four screens, four themes',
    body: 'Wear OS 3+, Android 11+, pure-black AR/TV HUD and the standalone 22.5 MB Windows tray EXE share Suprematist, Minimal, Classic and Liquid skins with probed extended controls.',
  },
  {
    index: '02',
    title: 'Local LAN Mesh & Firewall',
    body: 'Coordinate multiple local screens over 4-digit PIN without cloud servers or RFCOMM fights, protected by an app-layer LAN firewall in Developer Options and quick-park burst mode on phones.',
  },
  {
    index: '03',
    title: 'Spatial DSP & Hearing Guardrails',
    body: 'The 48 kHz 360° binaural lab works on any headset while auto-bypassing OS/hardware spatializers; paired with a 70% volume guard, in-ear block and 5-layer remote ring prohibition.',
  },
];

const steps = zh ? [
  ['Android手表/手机/眼镜同包安装', '配对蓝牙后点击上方「Android直连」下载带版本号的.apk（避免.apk.1重命名）；官方包延续v0.4.x签名可直接覆盖升级。'],
  ['Windows单文件双击即用', '点击「Windows单文件」获取22.5MB独立EXE，无需安装Java，启动后常驻任务栏右下角通知区并自动优选连接已配对耳机。'],
  ['确认安全提示后使用', '首次打开需确认听觉安全免责声明；标有「实验」的功能及查找耳机首次试用前请先摘下耳机并调低音量。'],
] : [
  ['Install one Android APK', 'Pair earbuds in Bluetooth settings, then download the versioned .apk (avoid .apk.1 renames for ADB). Official releases keep v0.4.x signatures for in-place upgrades.'],
  ['Run standalone Windows EXE', 'Download the 22.5 MB single-file Windows EXE with zero Java setup. It docks cleanly in the system tray and auto-selects paired earbuds.'],
  ['Review hearing safety gates', 'Confirm the disclaimer on first launch. Remove earbuds and lower system volume before testing [Experimental] features or Find My Buds.'],
];
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-labelledby="project-hero-title">
    <div class="deck-card deck-card-hero hero-section">
      <FallingTiles primary="yellow" secondary="blue" />
      <div class="shell hero-shell">
        <div class="hero-index label">
          <span><i class="label-mark" aria-hidden="true"></i> 01 / THE PROJECT</span>
          <span class="hero-index-right">
            <span>WATCH <span class="hero-cross">×</span> PHONE <span class="hero-cross">×</span> WIN <span class="hero-cross">×</span> HUD</span>
          </span>
        </div>

        <div class="project-hero-stage">
          <h1 id="project-hero-title" class="project-hero-title">
            <span class="project-title-main">{zh ? '腕上、掌间与桌面' : 'Watch, Phone & Win'}</span>
            <span class="project-title-sub">{zh ? '同一套声音控制' : 'Unified Earbud Control'}</span>
          </h1>

          <div class="action-row project-actions">
            <a class="button button-primary" data-arrow="down" href={site.directDownloadUrl} rel="noopener noreferrer" data-direct-download>
              <span>{zh ? 'Android直连' : 'Android APK'}</span>
              <span class="btn-arrow" aria-hidden="true">↓</span>
            </a>
            <a class="button button-outline" data-arrow="down" href={site.windowsDownloadUrl} target="_blank" rel="noopener noreferrer" data-direct-download>
              <span>{zh ? 'Windows单文件' : 'Windows EXE'}</span>
              <span class="btn-arrow" aria-hidden="true">↓</span>
              <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
            </a>
            <a class="text-link" href={releasesUrl} target="_blank" rel="noopener noreferrer">
              GitHub Releases <span aria-hidden="true">↗</span>
              <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
            </a>
          </div>

          <figure class="specimen-plate project-hero-figure">
            <div class="specimen-plate-stage">
              <AnimatedAppIcon size={340} />
            </div>
            <figcaption class="specimen-plate-caption">
              <span class="specimen-caption-left">
                <span class="chroma-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                <span>FIG. 02 · APK + EXE</span>
              </span>
              <button
                type="button"
                class="specimen-replay-btn"
                data-icon-replay
                aria-label={zh ? '重播图标构造动画' : 'Replay icon animation'}
              >
                <span aria-hidden="true">↻</span>
                <span>{zh ? '重绘' : 'REPLAY'}</span>
              </button>
            </figcaption>
          </figure>
        </div>

        <DownloadBay locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="1" aria-labelledby="experience-title">
    <div class="deck-card deck-sunk deck-fan-right">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell section-band-tight">
        <div class="section-header-bar" data-reveal>
          <div>
            <p class="label"><span class="label-mark green"></span>THE EXPERIENCE</p>
            <h2 id="experience-title">{zh ? '多端统一，边界清晰' : 'Unified UI, honest boundaries'}</h2>
          </div>
          <a class="text-link" href={site.appRepository} target="_blank" rel="noopener noreferrer">
            {zh ? '在GitHub查看项目' : 'View on GitHub'} <span aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>

        <div class="spec-trio">
          {specs.map((spec) => (
            <article class="spec-card">
              <span class="entry-index">{spec.index}</span>
              <h3>{spec.title}</h3>
              <p>{spec.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="getting-started">
    <div class="deck-card deck-paper deck-fan-left">
      <FallingTiles primary="blue" secondary="red" />
      <div class="shell section-band-tight split-content">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark yellow"></span>GETTING STARTED</p>
          <h2 id="getting-started">{zh ? '开始使用' : 'Getting started'}</h2>
          <p>{zh ? '三步完成安装与首次安全检查，手表与手机共用同一个安装包。' : 'Three steps to install and verify safety gates using a single shared APK.'}</p>
        </div>
        <ol class="step-list">
          {steps.map(([title, body], index) => (
            <li>
              <span class="entry-index">0{index + 1}</span>
              <div>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</FanDeck>
