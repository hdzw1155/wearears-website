---
import AnimatedAppIcon from '../components/AnimatedAppIcon.astro';
import DownloadBay from '../components/DownloadBay.astro';
import FanDeck from '../components/FanDeck.astro';
import FallingTiles from '../components/FallingTiles.astro';
import { pagePath, releasesUrl, site, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const steps = zh ? [
  ['配对耳机', '在Wear OS 3+手表或Android 11+手机的系统蓝牙中完成配对并连上耳机。'],
  ['获取并安装APK', '点击「下载」或从GitHub获取带版本号的.apk安装包；反复下载若被改名为.apk.1会被ADB拒装，官方包延续v0.4.x签名可直接覆盖。'],
  ['确认安全提示后使用', '首次打开需确认免责声明。标有「实验」的功能及查找耳机首次试用前，请先摘下耳机并调低系统音量。'],
] : [
  ['Pair the earbuds', 'Pair and connect your earbuds in system Bluetooth settings on Wear OS 3+ or Android 11+.'],
  ['Get and install the APK', 'Click Download above or get a versioned .apk from GitHub (avoid .apk.1 renames for ADB). Official releases preserve v0.4.x signatures for in-place upgrades.'],
  ['Review safety gates', 'Confirm the disclaimer on first launch. Remove earbuds and lower volume before testing [Experimental] features or Find My Buds.'],
];
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-labelledby="project-hero-title">
    <div class="deck-card deck-card-hero">
      <FallingTiles primary="yellow" secondary="blue" />
      <div class="hero shell project-hero">
        <div class="hero-index label">
          <span><i class="label-mark" aria-hidden="true"></i> 01 / THE PROJECT</span>
          <span class="hero-index-side">WEAR OS 3+ <span class="hero-cross">×</span> ANDROID 11+ <span class="hero-cross">×</span> TWS</span>
        </div>

        <div class="project-hero-stage">
          <h1 id="project-hero-title" class="project-hero-title">
            <span class="project-title-main">{zh ? '腕上与掌间' : 'Watch & Phone'}</span>
            <span class="project-title-sub">{zh ? '同一套声音控制' : 'Unified Earbud Control'}</span>
          </h1>
          <div class="action-row project-actions">
            <a class="button button-primary" href={site.directDownloadUrl} rel="noopener noreferrer" data-direct-download>
              {zh ? '下载' : 'Download'} <span aria-hidden="true">↓</span>
            </a>
            <a class="button button-outline" href={releasesUrl} target="_blank" rel="noopener noreferrer">
              GitHub <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
            </a>
            <a class="text-link" href={pagePath(locale, 'compatibility')}>
              {zh ? '查看兼容性' : 'Compatibility'} <span aria-hidden="true">→</span>
            </a>
          </div>

          <figure class="project-hero-figure">
            <AnimatedAppIcon size={440} />
            <figcaption>FIG. 02 <span></span> WATCH &amp; PHONE APK</figcaption>
          </figure>
        </div>

        <DownloadBay locale={locale} />
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="1" aria-labelledby="experience-title">
    <div class="deck-card deck-paper deck-fan-right">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell content-section split-content">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>THE EXPERIENCE</p>
          <h2 id="experience-title">{zh ? '双端统一 边界清晰' : 'Unified UI, honest boundaries'}</h2>
        </div>
        <div class="prose">
          <p class="lead">{zh
            ? 'v0.5.0-exp将至上、新极简、新经典与新液位四套界面统一到手表与手机双端，并接入通用特性引擎，按探测开放降噪档位、抗风噪、内置EQ、硬件空间音频与查找耳机。'
            : 'v0.5.0-exp unifies four themes across watch and phone while probing fine ANC levels, wind-noise control, EQ, hardware spatial audio and find-my-buds.'}</p>
          <p>{zh
            ? '手机端默认启用按需短连接（同步后空闲3.8秒自动归还RFCOMM通道，点击再唤醒并设12秒防抢占守卫），解决国产系统后台抢占导致的闪烁耗电；手表端保持常连与磁贴实时刷新。'
            : 'Phones default to on-demand burst links (3.8s idle release + 12s anti-hijack guard) to prevent system Bluetooth fighting, while watches stay persistently connected with live tiles.'}</p>
          <p>{zh
            ? '本机单端空间音频与360°双耳HRTF实验室支持任意蓝牙耳机，但仅作用于当前设备本机播放的媒体流；开启硬件或系统自带Spatializer时自动旁路。内置70%音量护栏与查找耳机佩戴拦截。'
            : 'Local spatial DSP and the 360° binaural lab work with any headset for local media playback, auto-bypassing when hardware or OS Spatializer is active, alongside a 70% volume guard and wear-safety gates.'}</p>
          <a class="text-link" href={site.appRepository} target="_blank" rel="noopener noreferrer">{zh ? '在GitHub查看项目' : 'View the project on GitHub'} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="getting-started">
    <div class="deck-card deck-paper deck-fan-left">
      <FallingTiles primary="blue" secondary="red" />
      <div class="shell content-section split-content ruled">
        <div class="section-lead">
          <p class="label"><span class="label-mark"></span>GETTING STARTED</p>
          <h2 id="getting-started">{zh ? '开始使用' : 'Getting started'}</h2>
        </div>
        <ol class="step-list">
          {steps.map(([title, body], index) => (
            <li><span class="entry-index">0{index + 1}</span><div><h3>{title}</h3><p>{body}</p></div></li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</FanDeck>
