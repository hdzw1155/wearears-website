---
import FallingTiles from '../components/FallingTiles.astro';
import FanDeck from '../components/FanDeck.astro';
import PageIntro from '../components/PageIntro.astro';
import { site, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
---

<FanDeck>
  <section class="slide-section deck-hero is-active" data-slide data-slide-index="0" aria-label={zh ? '隐私与商标概述' : 'Privacy and trademarks introduction'}>
    <div class="deck-card deck-card-hero">
      <FallingTiles primary="yellow" secondary="blue" />
      <PageIntro
        label="DATA / PRIVACY"
        meta="LOCAL BLUETOOTH · ZERO TELEMETRY · MIT"
        title={zh ? '应用与网站如何处理数据' : 'How the app and site handle data'}
        summary={zh
          ? 'WearEars客户端纯本地蓝牙通信、不联网且不收集数据。本页同时说明官网静态查询与商标使用边界。'
          : 'The WearEars app runs purely over local Bluetooth with zero network calls or telemetry. This page also covers website handling and trademarks.'}
      />
      <div class="shell" style="padding-bottom: clamp(1.5rem, 3vw, 2.5rem);">
        <div class="stat-strip" style="margin-bottom: 0;">
          <div class="stat-cell">
            <span class="label">{zh ? '公网数据上传' : 'CLOUD UPLOADS'}</span>
            <strong class="is-green">0</strong>
          </div>
          <div class="stat-cell">
            <span class="label">{zh ? '第三方统计埋点' : 'TRACKERS'}</span>
            <strong class="is-green">0</strong>
          </div>
          <div class="stat-cell">
            <span class="label">{zh ? '本地蓝牙通信' : 'LOCAL BLUETOOTH'}</span>
            <strong>100%</strong>
          </div>
          <div class="stat-cell">
            <span class="label">{zh ? '源码开源许可' : 'SOURCE LICENSE'}</span>
            <strong class="is-blue">MIT</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="1" aria-labelledby="privacy-details">
    <div class="deck-card deck-paper deck-fan-right">
      <FallingTiles primary="green" secondary="yellow" />
      <div class="shell section-band-tight split-content">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark green"></span>DATA BOUNDARIES</p>
          <h2 id="privacy-details">{zh ? '数据流向' : 'Where data goes'}</h2>
        </div>
        <div class="prose">
          <h3>{zh ? 'WearEars安卓与手表客户端' : 'WearEars Watch & Phone App'}</h3>
          <p>
            {zh
              ? '客户端不申请网络访问遥测通道，不联网、不埋点、不收集或上传任何蓝牙地址、耳机电量、使用习惯或音频流。'
              : 'The app communicates strictly over local Bluetooth and system audio APIs, with zero network telemetry, analytics or data uploads.'}
          </p>
          <h3>{zh ? '官网兼容性查询' : 'Compatibility searches'}</h3>
          <p>
            {zh
              ? '设备记录随网页静态加载。型号关键词与品牌筛选全部在您当前的浏览器本地处理，不会向后台发送搜索日志。'
              : 'Device records load statically with the page. Model searches and filters run locally in your browser.'}
          </p>
          <h3>{zh ? 'GitHub与公开交流' : 'GitHub and public discussions'}</h3>
          <p>
            {zh
              ? '安装包下载、源码查阅和问题反馈链接会跳转到GitHub。您提交的Issue或评论的可见性由GitHub平台规则与个人账户设置决定。'
              : 'Downloads, source links and discussions open on GitHub, governed by GitHub platform and account visibility settings.'}
          </p>
          <a class="text-link" href={site.sourceRepository} target="_blank" rel="noopener noreferrer">
            {zh ? '查看官网源码' : 'View the website source'} <span aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="slide-section deck-sheet" data-slide data-slide-index="2" aria-labelledby="trademark-details">
    <div class="deck-card deck-sunk deck-fan-left">
      <FallingTiles primary="blue" secondary="red" />
      <div class="shell section-band-tight split-content">
        <div class="section-lead" data-reveal>
          <p class="label"><span class="label-mark yellow"></span>TRADEMARKS</p>
          <h2 id="trademark-details">{zh ? '商标与品牌权利' : 'Trademarks & brand identity'}</h2>
        </div>
        <div class="prose">
          <h3>{zh ? 'MIT开源许可与商标权属的区分' : 'Separation of MIT License and trademarks'}</h3>
          <p>
            {zh
              ? 'WearEars项目核心源码采用MIT许可证开放。MIT许可仅适用于软件代码本身，不授予使用WearEars名称、官方应用启动图标及相关视觉标识的商标许可。'
              : 'WearEars source code is licensed under the MIT License. The MIT License applies to software code only and does not grant permission to use the WearEars name, official app launcher icon, or brand identity.'}
          </p>
          <h3>{zh ? '合理引用与二次分发' : 'Permitted reference & forks'}</h3>
          <p>
            {zh
              ? '允许在客观描述兼容性或标明原始项目出处时真实引用WearEars名称。任何衍生分发或第三方商业发布版本，必须移除官方应用图标并替换为独立标识，且不得暗示拥有WearEars官方背书；本项目亦与各耳机厂商无任何隶属或授权关系。'
              : 'Truthful nominative reference is permitted to state compatibility or cite project origin. Derivative distributions must remove official brand icons and must not imply official endorsement; WearEars is unaffiliated with any earbud manufacturer.'}
          </p>
          <a class="text-link" href={site.sourceRepository + '/blob/gemini-refinement/TRADEMARKS.md'} target="_blank" rel="noopener noreferrer">
            {zh ? '阅读完整商标政策（TRADEMARKS.md）' : 'Read full trademark policy (TRADEMARKS.md)'} <span aria-hidden="true">↗</span>
            <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</FanDeck>
