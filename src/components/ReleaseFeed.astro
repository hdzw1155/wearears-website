---
import releases from '../data/releases.json';
import { type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  limit?: number;
}
const { locale, limit } = Astro.props;
const zh = locale === 'zh';
const entries = limit ? releases.slice(0, limit) : releases;
const date = new Intl.DateTimeFormat('sv-SE', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<ol class="release-list">
  {entries.map((release) => (
    <li>
      <a href={release.url} target="_blank" rel="noopener noreferrer">
        <time datetime={release.publishedAt}>{date.format(new Date(release.publishedAt))}</time>
        <span class="release-title">WearEars {release.tag}</span>
        <span class="release-kind">{release.prerelease ? (zh ? '预发布' : 'Preview') : (zh ? '发布记录' : 'Release')}</span>
        <span class="release-arrow" aria-hidden="true">↗</span>
        <span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
      </a>
    </li>
  ))}
</ol>
