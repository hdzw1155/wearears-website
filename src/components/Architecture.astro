---
import { appSource, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const layers = [
  {
    title: zh ? '界面、双端适配与安全门禁' : 'UI, Dual-Device & Safety Gates',
    code: 'MainActivity · SafetyGates · Tiles',
    body: zh
      ? '自适应手表圆屏与手机竖屏，四套皮肤统一，内置70%音量护栏与查找耳机三层保护。'
      : 'Adapts between round watches and portrait phones across 4 themes with 70% volume and wear-safety gates.',
    source: 'app/src/com/hdz/wearcontrol/MainActivity.java',
  },
  {
    title: zh ? '协调、短连接与特性引擎' : 'Hub, Burst Mode & Feature Engine',
    code: 'ControlHub · FeatureTransactions',
    body: zh
      ? '手机端3.8秒按需释放RFCOMM并设12秒防抢占守卫，14类扩展特性隔离事务。'
      : 'Phones release RFCOMM after 3.8s idle with a 12s anti-hijack guard; 14 feature IDs run in isolated lanes.',
    source: 'core/src/com/hdz/wearcontrol/FeatureTransactions.java',
  },
  {
    title: zh ? '九品牌驱动与构建裁剪' : 'Nine Brand Drivers & Trimming',
    code: 'DriverRegistry · modules.json',
    body: zh
      ? '编译期按需裁剪9个品牌驱动，独立线程运行，探测确认能力后才开放写入。'
      : 'Compile-time trimming across 9 brand drivers; per-link threads confirm capability before writes.',
    source: 'app/src/com/hdz/wearcontrol/DriverRegistry.java',
  },
  {
    title: zh ? '传输链路与本机声学内核' : 'Transport & Binaural HRTF Kernel',
    code: 'RfcommLink · GattPump · 48kHz HRTF',
    body: zh
      ? 'RFCOMM/GATT与标准蓝牙兜底，内嵌纯Java零GC 48kHz双耳HRTF内核。'
      : 'RFCOMM/GATT and standard Bluetooth fallback paired with a zero-GC 48 kHz Java binaural kernel.',
    source: 'core/src/com/hdz/wearcontrol/WearEarsBinauralKernel.java',
  },
];
---

<ol class="architecture" aria-label={zh ? '四层架构' : 'Four layers of the architecture'}>
  {layers.map((layer, index) => (
    <li class={'architecture-layer layer-' + (index + 1)}>
      <details open={index === 0}>
        <summary>
          <span class="layer-index" aria-hidden="true">0{index + 1}</span>
          <span class="layer-name">{layer.title}</span>
          <span class="layer-code">{layer.code}</span>
          <span class="layer-toggle" aria-hidden="true"></span>
        </summary>
        <div class="layer-detail">
          <p>{layer.body}</p>
          <a href={appSource + layer.source} target="_blank" rel="noopener noreferrer">
            {zh ? '查看源码' : 'View source'} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>
      </details>
    </li>
  ))}
</ol>
