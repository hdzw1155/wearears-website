---
import { appSource, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const layers = [
  {
    title: zh ? '交互展示与安全门禁' : 'Interaction & Safety Gates',
    code: 'MainActivity · DesktopApp · SafetyGates',
    body: zh
      ? '手表圆屏、手机竖屏、纯黑眼镜HUD、Windows托盘与磁贴共用四套皮肤；前置70%音量护栏与查找耳机入耳三层保护。'
      : 'Round watch, portrait phone, pure-black HUD, Windows tray and tiles share four themes behind a 70% volume guard and three-layer wear protection.',
    source: 'app/src/com/hdz/wearcontrol/MainActivity.java',
  },
  {
    title: zh ? '统一契约与核心规则' : 'Unified Contract & Core Rules',
    code: 'TwsClient · ControlHub · FeatureTransactions',
    body: zh
      ? '纯JVM统一连接、电量与能力位契约，管理选机、真实状态、主降噪与14类扩展特性隔离事务，以及手机按需短连接与局域网协同规则。'
      : 'Pure JVM contract for connections, battery and capability flags, coordinating selection, state, 14 isolated feature lanes, quick-park burst mode and local LAN rules.',
    source: 'core/src/com/hdz/wearcontrol/FeatureTransactions.java',
  },
  {
    title: zh ? '驱动调度与品牌协议' : 'Driver Dispatch & Brand Protocols',
    code: 'DriverRegistry · WireDriver · modules.json',
    body: zh
      ? '根据设备信息匹配9大品牌私有驱动，支持编译期按需裁剪；独立线程按探测回包确认能力后再开放写入，并在编码层硬拦截禁发指令。'
      : 'Matches 9 brand drivers with compile-time trimming; per-link threads confirm capability replies before enabling writes and hard-block unsafe opcodes.',
    source: 'app/src/com/hdz/wearcontrol/DriverRegistry.java',
  },
  {
    title: zh ? '设备通信与声学底座' : 'Device Transport & Acoustic Kernel',
    code: 'RfcommLink · GattPump · BtBridge · 48kHz HRTF',
    body: zh
      ? '底层执行RFCOMM、BLE GATT、Windows原生蓝牙桥与标准蓝牙整机电量兜底，并内嵌本机单端空间音频与48kHz零GC双耳HRTF内核。'
      : 'Handles RFCOMM, BLE GATT, the native Windows Bluetooth bridge and standard battery fallback alongside local spatial DSP and the zero-GC 48 kHz binaural HRTF kernel.',
    source: 'core/src/com/hdz/wearcontrol/WearEarsBinauralKernel.java',
  },
];
---

<ol class="architecture" aria-label={zh ? '四层架构' : 'Four layers of the architecture'}>
  {layers.map((layer, index) => (
    <li class={'architecture-layer layer-' + (index + 1)}>
      <details open={index === 0}>
        <summary>
          <span class="layer-index" aria-hidden="true">0{index + 1}</span>
          <span class="layer-name">{layer.title}</span>
          <span class="layer-code">{layer.code}</span>
          <span class="layer-toggle" aria-hidden="true"></span>
        </summary>
        <div class="layer-detail">
          <p>{layer.body}</p>
          <a href={appSource + layer.source} target="_blank" rel="noopener noreferrer">
            {zh ? '查看源码' : 'View source'} <span aria-hidden="true">↗</span><span class="sr-only">{zh ? '（在新标签页打开）' : ' (opens in a new tab)'}</span>
          </a>
        </div>
      </details>
    </li>
  ))}
</ol>
